{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "etch-mailer",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "SENDING_DOMAIN": "example.com"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "observability": {
    "enabled": true
  }
}
