{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "etch-forms-client",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "vars": {
    "SITE_NAME": "Your client website",
    "SITE_DOMAIN": "example.com",
    "RECIPIENT_EMAIL": "hello@example.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "client-site",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    {
      "binding": "MAILER",
      "service": "etch-mailer"
    }
  ],
  "ratelimits": [
    {
      "name": "BURST_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
